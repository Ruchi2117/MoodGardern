# Development uses loopback. Set NODE_ENV=production on your hosting platform.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/moodgarden
JWT_SECRET=
PORT=5000
# Required in production: exact frontend origin, no trailing slash.
CLIENT_ORIGIN=http://127.0.0.1:5173
# Optional: production defaults to 0.0.0.0; development defaults to 127.0.0.1.
HOST=
# Optional: number of trusted reverse-proxy hops; leave blank for direct access.
TRUST_PROXY=
